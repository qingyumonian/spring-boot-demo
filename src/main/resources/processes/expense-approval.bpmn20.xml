<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://www.flowable.org/processdef"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL
                                 http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd">

    <process id="expense-approval" name="报销审批流程" isExecutable="true">
        <documentation>报销审批流程：提交 -> 主管审批 -> (金额>1000) -> 财务审批 -> 结束</documentation>

        <!-- 开始事件 -->
        <startEvent id="startEvent" name="开始">
            <extensionElements>
                <flowable:formProperty id="initiator" name="发起人" type="string"/>
            </extensionElements>
        </startEvent>

        <!-- 主管审批 -->
        <userTask id="managerApproval" name="主管审批" flowable:candidateGroups="MANAGER">
            <documentation>主管审批报销申请</documentation>
            <extensionElements>
                <flowable:formProperty id="approved" name="是否同意" type="boolean" required="true"/>
                <flowable:formProperty id="comment" name="审批意见" type="string"/>
            </extensionElements>
        </userTask>

        <!-- 主管审批后网关 -->
        <exclusiveGateway id="managerGateway" name="主管审批结果"/>

        <!-- 金额判断网关 -->
        <exclusiveGateway id="amountGateway" name="金额判断"/>

        <!-- 财务审批 -->
        <userTask id="financeApproval" name="财务审批" flowable:candidateGroups="FINANCE">
            <documentation>财务审批大额报销申请</documentation>
            <extensionElements>
                <flowable:formProperty id="approved" name="是否同意" type="boolean" required="true"/>
                <flowable:formProperty id="comment" name="审批意见" type="string"/>
            </extensionElements>
        </userTask>

        <!-- 财务审批后网关 -->
        <exclusiveGateway id="financeGateway" name="财务审批结果"/>

        <!-- 结束事件 - 通过 -->
        <endEvent id="endApproved" name="审批通过"/>

        <!-- 结束事件 - 拒绝 -->
        <endEvent id="endRejected" name="审批拒绝"/>

        <!-- 流程线 -->
        <!-- 开始 -> 主管审批 -->
        <sequenceFlow id="flow1" sourceRef="startEvent" targetRef="managerApproval"/>

        <!-- 主管审批 -> 主管审批结果网关 -->
        <sequenceFlow id="flow2" sourceRef="managerApproval" targetRef="managerGateway"/>

        <!-- 主管拒绝 -> 结束(拒绝) -->
        <sequenceFlow id="flow3" sourceRef="managerGateway" targetRef="endRejected" name="拒绝">
            <conditionExpression xsi:type="tFormalExpression">${approved == false}</conditionExpression>
        </sequenceFlow>

        <!-- 主管同意 -> 金额判断 -->
        <sequenceFlow id="flow4" sourceRef="managerGateway" targetRef="amountGateway" name="同意">
            <conditionExpression xsi:type="tFormalExpression">${approved == true}</conditionExpression>
        </sequenceFlow>

        <!-- 金额>1000 -> 财务审批 -->
        <sequenceFlow id="flow5" sourceRef="amountGateway" targetRef="financeApproval" name="大额">
            <conditionExpression xsi:type="tFormalExpression">${amount > 1000}</conditionExpression>
        </sequenceFlow>

        <!-- 金额<=1000 -> 结束(通过) -->
        <sequenceFlow id="flow6" sourceRef="amountGateway" targetRef="endApproved" name="小额">
            <conditionExpression xsi:type="tFormalExpression">${amount &lt;= 1000}</conditionExpression>
        </sequenceFlow>

        <!-- 财务审批 -> 财务审批结果网关 -->
        <sequenceFlow id="flow7" sourceRef="financeApproval" targetRef="financeGateway"/>

        <!-- 财务同意 -> 结束(通过) -->
        <sequenceFlow id="flow8" sourceRef="financeGateway" targetRef="endApproved" name="同意">
            <conditionExpression xsi:type="tFormalExpression">${approved == true}</conditionExpression>
        </sequenceFlow>

        <!-- 财务拒绝 -> 结束(拒绝) -->
        <sequenceFlow id="flow9" sourceRef="financeGateway" targetRef="endRejected" name="拒绝">
            <conditionExpression xsi:type="tFormalExpression">${approved == false}</conditionExpression>
        </sequenceFlow>

    </process>

    <!-- 流程图布局 -->
    <bpmndi:BPMNDiagram id="BPMNDiagram_expense-approval">
        <bpmndi:BPMNPlane bpmnElement="expense-approval" id="BPMNPlane_expense-approval">
            <bpmndi:BPMNShape id="startEvent_di" bpmnElement="startEvent">
                <omgdc:Bounds x="100" y="200" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="managerApproval_di" bpmnElement="managerApproval">
                <omgdc:Bounds x="200" y="178" width="100" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="managerGateway_di" bpmnElement="managerGateway">
                <omgdc:Bounds x="350" y="193" width="50" height="50"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="amountGateway_di" bpmnElement="amountGateway">
                <omgdc:Bounds x="450" y="193" width="50" height="50"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="financeApproval_di" bpmnElement="financeApproval">
                <omgdc:Bounds x="550" y="178" width="100" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="financeGateway_di" bpmnElement="financeGateway">
                <omgdc:Bounds x="700" y="193" width="50" height="50"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="endApproved_di" bpmnElement="endApproved">
                <omgdc:Bounds x="800" y="200" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="endRejected_di" bpmnElement="endRejected">
                <omgdc:Bounds x="550" y="320" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNEdge id="flow1_di" bpmnElement="flow1">
                <omgdi:waypoint x="136" y="218"/>
                <omgdi:waypoint x="200" y="218"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="flow2_di" bpmnElement="flow2">
                <omgdi:waypoint x="300" y="218"/>
                <omgdi:waypoint x="350" y="218"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="flow3_di" bpmnElement="flow3">
                <omgdi:waypoint x="375" y="243"/>
                <omgdi:waypoint x="375" y="338"/>
                <omgdi:waypoint x="550" y="338"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="flow4_di" bpmnElement="flow4">
                <omgdi:waypoint x="400" y="218"/>
                <omgdi:waypoint x="450" y="218"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="flow5_di" bpmnElement="flow5">
                <omgdi:waypoint x="500" y="218"/>
                <omgdi:waypoint x="550" y="218"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="flow6_di" bpmnElement="flow6">
                <omgdi:waypoint x="475" y="193"/>
                <omgdi:waypoint x="475" y="130"/>
                <omgdi:waypoint x="818" y="130"/>
                <omgdi:waypoint x="818" y="200"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="flow7_di" bpmnElement="flow7">
                <omgdi:waypoint x="650" y="218"/>
                <omgdi:waypoint x="700" y="218"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="flow8_di" bpmnElement="flow8">
                <omgdi:waypoint x="750" y="218"/>
                <omgdi:waypoint x="800" y="218"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="flow9_di" bpmnElement="flow9">
                <omgdi:waypoint x="725" y="243"/>
                <omgdi:waypoint x="725" y="338"/>
                <omgdi:waypoint x="586" y="338"/>
            </bpmndi:BPMNEdge>
        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>

</definitions>
