# ==================== 环境变量配置示例 ====================
# 复制此文件为 .env 并根据实际情况修改

# ========== MySQL 配置 ==========
MYSQL_ROOT_PASSWORD=your_secure_password
MYSQL_DATABASE=lxf-demo-prod
MYSQL_PORT=3306

# ========== Redis 配置 ==========
REDIS_PASSWORD=your_redis_password
REDIS_PORT=6379

# ========== 服务端口 ==========
BACKEND_PORT=8888
FRONTEND_PORT=80

# ========== JVM 配置 ==========
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC

# ========== SSO 配置 (可选) ==========
# Keycloak OIDC
SSO_KEYCLOAK_ENABLED=false
SSO_KEYCLOAK_BASE_URL=http://keycloak:8080
SSO_KEYCLOAK_REALM=your-realm
SSO_KEYCLOAK_CLIENT_ID=your-client-id
SSO_KEYCLOAK_CLIENT_SECRET=your-client-secret

# CAS 2.0
SSO_CAS_ENABLED=false
SSO_CAS_SERVER_URL_PREFIX=https://cas-server/cas
SSO_CAS_CLIENT_HOST_URL=http://your-domain.com
